# Orbital Holdfast — build, sign, upload and publish the App Store listing from GitHub Actions.
# Repository secrets: ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_P8 (contents of the .p8 file).
default_platform(:ios)

APP_ID = "com.cubiccm.holdfast"
XCPROJ = "ios/App/App.xcodeproj"
XCWS   = "ios/App/App.xcworkspace"

def asc_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_content: ENV.fetch("ASC_KEY_P8"),
    in_house: false
  )
end

platform :ios do
  desc "Archive and upload the app to App Store Connect / TestFlight"
  lane :release do
    api_key = asc_key
    setup_ci
    get_certificates(api_key: api_key, development: false, generate_apple_certs: true)
    get_provisioning_profile(api_key: api_key, app_identifier: APP_ID, force: true)
    profile_name = lane_context[SharedValues::SIGH_NAME]
    profile_path = lane_context[SharedValues::SIGH_PROFILE_PATH]
    team_id = sh("security cms -D -i '#{profile_path}' | plutil -extract TeamIdentifier.0 raw -").strip
    UI.message("Team #{team_id} — profile #{profile_name}")

    update_code_signing_settings(
      path: XCPROJ, use_automatic_signing: false, team_id: team_id,
      code_sign_identity: "Apple Distribution", profile_name: profile_name,
      bundle_identifier: APP_ID, targets: ["App"]
    )

    latest = begin
      latest_testflight_build_number(api_key: api_key, app_identifier: APP_ID, initial_build_number: 0)
    rescue => e
      UI.important("Could not read latest build number (#{e.message}); starting at 0"); 0
    end
    build_no = (latest.to_i + 1).to_s
    UI.message("Build number #{build_no}")

    build_app(
      workspace: XCWS, scheme: "App", configuration: "Release", export_method: "app-store",
      xcargs: "CURRENT_PROJECT_VERSION=#{build_no} DEVELOPMENT_TEAM=#{team_id}",
      export_options: { provisioningProfiles: { APP_ID => profile_name }, signingStyle: "manual", teamID: team_id },
      output_directory: "build", output_name: "OrbitalHoldfast.ipa"
    )

    upload_to_testflight(api_key: api_key, ipa: "build/OrbitalHoldfast.ipa", skip_waiting_for_build_processing: true)
  end

  desc "Push the store listing: text, screenshots, categories, age rating, privacy"
  lane :listing do
    api_key = asc_key
    deliver(
      api_key: api_key, app_identifier: APP_ID, app_version: "1.0",
      skip_binary_upload: true,
      metadata_path: "fastlane/metadata", screenshots_path: "fastlane/screenshots",
      overwrite_screenshots: true, app_rating_config_path: "fastlane/rating.json",
      precheck_include_in_app_purchases: false, run_precheck_before_submit: false,
      force: true, submit_for_review: false
    )
    upload_app_privacy_details_to_app_store(api_key: api_key, app_identifier: APP_ID, json_path: "fastlane/privacy.json")
  end

  desc "Attach the newest processed build to 1.0 and submit for review"
  lane :submit do
    api_key = asc_key
    build = latest_testflight_build_number(api_key: api_key, app_identifier: APP_ID)
    deliver(
      api_key: api_key, app_identifier: APP_ID, app_version: "1.0", build_number: build.to_s,
      skip_binary_upload: true, skip_screenshots: true, skip_metadata: true,
      run_precheck_before_submit: false, force: true,
      submit_for_review: true, automatic_release: true,
      submission_information: { add_id_info_uses_idfa: false, export_compliance_uses_encryption: false }
    )
  end
end

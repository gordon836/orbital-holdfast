# Orbital Holdfast — build, sign, upload and publish the App Store listing from GitHub Actions.
# Repository secrets: ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_P8 (contents of the .p8 file).
#
# Signing: the first run creates an Apple Distribution certificate and saves its private key
# (encrypted with a key derived from ASC_KEY_P8) under signing/ so the workflow can cache it.
# Later runs restore that file, so no new certificates are created (Apple allows only three).
default_platform(:ios)

require "digest"

APP_ID = "com.cubiccm.holdfast"
XCPROJ = "ios/App/App.xcodeproj"
XCWS   = "ios/App/App.xcworkspace"
SIGN_DIR = File.expand_path("../signing", __dir__)
ENC_FILE = File.join(SIGN_DIR, "dist.p12.enc")
ID_FILE  = File.join(SIGN_DIR, "cert_id.txt")

def asc_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_content: ENV.fetch("ASC_KEY_P8"),
    in_house: false
  )
end

def enc_pass
  Digest::SHA256.hexdigest("holdfast-signing:" + ENV.fetch("ASC_KEY_P8"))
end

platform :ios do
  desc "Archive and upload the app to App Store Connect / TestFlight"
  lane :release do
    api_key = asc_key
    setup_ci
    keychain = File.expand_path("~/Library/Keychains/fastlane_tmp_keychain-db")
    FileUtils.mkdir_p(SIGN_DIR)

    cert_id = nil
    if File.exist?(ENC_FILE) && File.exist?(ID_FILE)
      UI.message("Restoring cached distribution certificate")
      p12 = File.join(SIGN_DIR, "dist.p12")
      sh("openssl enc -d -aes-256-cbc -pbkdf2 -in '#{ENC_FILE}' -out '#{p12}' -pass pass:#{enc_pass}")
      import_certificate(certificate_path: p12, certificate_password: "", keychain_path: keychain, keychain_password: "")
      cert_id = File.read(ID_FILE).strip
      File.delete(p12)
      # The .p12 holds only the private key; download the public certificate from Apple
      # and install it so the keychain has a complete signing identity.
      require "base64"
      Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: api_key)
      remote = Spaceship::ConnectAPI::Certificate.all(filter: { id: cert_id }).first
      UI.user_error!("Certificate #{cert_id} no longer exists on the Apple Developer portal — delete the 'dist-cert-v1' Actions cache and re-run") unless remote
      cer = File.join(SIGN_DIR, "dist.cer")
      File.binwrite(cer, Base64.decode64(remote.certificate_content))
      import_certificate(certificate_path: cer, keychain_path: keychain, keychain_password: "")
      File.delete(cer)
      sh("security find-identity -v -p codesigning '#{keychain}'")
    else
      UI.message("No cached certificate — creating one")
      get_certificates(api_key: api_key, development: false, generate_apple_certs: true, output_path: SIGN_DIR, keychain_path: keychain, keychain_password: "")
      cert_id = lane_context[SharedValues::CERT_CERTIFICATE_ID]
      p12 = Dir[File.join(SIGN_DIR, "*.p12")].first
      UI.user_error!("Certificate private key was not exported") unless p12
      sh("openssl enc -aes-256-cbc -pbkdf2 -in '#{p12}' -out '#{ENC_FILE}' -pass pass:#{enc_pass}")
      File.write(ID_FILE, cert_id)
      Dir[File.join(SIGN_DIR, "*.p12"), File.join(SIGN_DIR, "*.cer")].each { |f| File.delete(f) }
    end

    get_provisioning_profile(api_key: api_key, app_identifier: APP_ID, cert_id: cert_id, force: true)
    profile_name = lane_context[SharedValues::SIGH_NAME]
    profile_path = lane_context[SharedValues::SIGH_PROFILE_PATH]
    team_id = sh("security cms -D -i '#{profile_path}' | plutil -extract TeamIdentifier.0 raw -").strip
    UI.message("Team #{team_id} — profile #{profile_name} — cert #{cert_id}")

    update_code_signing_settings(
      path: XCPROJ, use_automatic_signing: false, team_id: team_id,
      code_sign_identity: "Apple Distribution", profile_name: profile_name,
      bundle_identifier: APP_ID, targets: ["App"]
    )

    latest = begin
      latest_testflight_build_number(api_key: api_key, app_identifier: APP_ID, initial_build_number: 0)
    rescue => e
      UI.important("Could not read latest build number (#{e.message}); starting at 0"); 0
    end
    build_no = (latest.to_i + 1).to_s
    UI.message("Build number #{build_no}")

    build_app(
      workspace: XCWS, scheme: "App", configuration: "Release", export_method: "app-store",
      xcargs: "CURRENT_PROJECT_VERSION=#{build_no} DEVELOPMENT_TEAM=#{team_id}",
      export_options: { provisioningProfiles: { APP_ID => profile_name }, signingStyle: "manual", teamID: team_id },
      output_directory: "build", output_name: "OrbitalHoldfast.ipa"
    )

    upload_to_testflight(api_key: api_key, ipa: "build/OrbitalHoldfast.ipa", skip_waiting_for_build_processing: true)
  end

  desc "Push the store listing: text, screenshots, categories, age rating, privacy"
  lane :listing do
    api_key = asc_key
    deliver(
      api_key: api_key, app_identifier: APP_ID, app_version: "1.0",
      skip_binary_upload: true,
      metadata_path: "fastlane/metadata", screenshots_path: "fastlane/screenshots",
      overwrite_screenshots: true, app_rating_config_path: "fastlane/rating.json",
      precheck_include_in_app_purchases: false, run_precheck_before_submit: false,
      force: true, submit_for_review: false
    )
    # App Privacy ("no data collected") is set once in App Store Connect → App Privacy;
    # fastlane's upload_app_privacy_details_to_app_store needs an Apple ID login, not an API key.
  end

  desc "Attach the newest processed build to 1.0 and submit for review"
  lane :submit do
    api_key = asc_key
    build = latest_testflight_build_number(api_key: api_key, app_identifier: APP_ID)
    deliver(
      api_key: api_key, app_identifier: APP_ID, app_version: "1.0", build_number: build.to_s,
      skip_binary_upload: true, skip_screenshots: true, skip_metadata: true,
      run_precheck_before_submit: false, force: true,
      submit_for_review: true, automatic_release: true,
      submission_information: { add_id_info_uses_idfa: false, export_compliance_uses_encryption: false }
    )
  end
end
